# ملف مثال للمتغيرات البيئية
# انسخ هذا الملف إلى .env وضع قيمك الحقيقية

# للتطوير المحلي - استخدم بوت تجريبي
TELEGRAM_BOT_TOKEN=your_dev_bot_token_here

# للإنتاج على Heroku/Render - استخدم البوت الرئيسي
# TELEGRAM_BOT_TOKEN=your_production_bot_token_here

# قاعدة البيانات (اتركها فارغة للتطوير المحلي - سيستخدم SQLite)
# DATABASE_URL=postgresql://...
